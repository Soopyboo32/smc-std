import {panic} from "@std/panic";

fn _charAt(string: str, index: int): str native "charAt";

pub class String {
	static pub fn charAt(self: str, index: int) {
		return _charAt(self, index);
	}

	static pub fn append(self: str, other: str) {
		return self + other;
	}

	static pub fn len(self: str) {
		panic("TODO: implement string.len()");
	}

	static pub fn iterator(self: str) {
		panic("TODO: implement string.iterator()");
	}
}